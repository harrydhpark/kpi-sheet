{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "Raw data/**",
      "*.xlsx",
      "build_dashboard.js",
      "index.js",
      "firepit-log.txt",
      "Dockerfile"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
